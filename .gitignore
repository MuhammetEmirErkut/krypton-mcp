# KryptonMCP - Professional Git Ignore Rules

# 1. Binaries and build artifacts
/bin/
/dist/
/build/
*.exe
*.exe~
*.dll
*.so
*.dylib
/krypton
/krypton-mcp

# 2. Test and coverage artifacts
*.out
*.test
coverage.html
coverage.txt
.coverage/

# 3. Developer private checklist and local task tracker (CRITICAL: NEVER COMMIT)
DEVELOPER.md
DEVELOPER.local.md
MEMORY.md
MEMORY.local.md
*.local.md

# 4. Secrets, private keys, certificates, and generated credentials
.env
.env.*
*.pem
*.key
*.pub
*.cert
*.crt
/secrets/
/credentials/
/local_keys/
/security-keys/

# 5. Local Runtime Configuration Files (Prevent accidental commit of production/local DB secrets)
krypton.yaml
krypton.yml
config.yaml
config.yml
*.local.yaml
*.local.yml
demo-*.yaml
demo-*.yml
test-*.yaml
test-*.yml

# (Allow example/template configs)
!*.example.yaml
!*.example.yml
!*.template.yaml
!*.template.yml

# 6. Runtime logs, databases, and Merkle audit ledgers
*.log
*.jsonl
krypton-audit.log
audit.jsonl
audit_cache/
tmp/
temp/

# 7. IDE, OS, and tool artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
demo.tape
